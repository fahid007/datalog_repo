<?xml version="1.0" encoding="UTF-8"?>
<recipe>
  <smartest force_restart="false">
    <version>soc64_7.10.6.0</version>
    <startup_mode>online</startup_mode>
    <user_mode>engineer</user_mode>
    <env>
     <V93000_MODEL>/etc/opt/hp93000/soc/tester.model</V93000_MODEL>
      <!-- here can specify the env variables for smartest using, for example -->
      <!-- <LD_LIBRARY_PATH>/path/or/paths/to/3rd_party_libs</LD_LIBRARY_PATH> -->
    </env>
  </smartest>
  <testflow name="/home/demo/projects/Apogeesemi/CROW/Production_Codes/REV01/REV01/CROW_ARPS10X0X5_REV01/CROW_ARPS10X0X5_TP/testflow/ARPS1050A5_tf_REV01P01.mfh" />
  <equipment testtype="HANDLER" vendor="Esmo" model="Talos"  />
  <datalog>
    <profile name="datalog_ON.prf" />
    <lot_variables>
      <variable name="LOT_ID" value="12345" />
      <variable name="OPER_NAM" value="Joe" />
      <variable name="TST_TEMP" value="25C" />
      <variable name="TEST_COD" value="FT" />
      <variable name="DEVICE_VARIENT" value="50" />
      <variable name="TEMP" value="25" />
      
    </lot_variables>
    <file perwafer="false" path="/home/demo/projects/Apogeesemi/CROW/TCCT_FILES"
      name="datalog_{HOSTNAME}_{LOGNAME}_{LOT_ID}_{TST_TEMP}_{TIMESTAMP}">
      <stdf enable="true" ext="stdf" />
      <text enable="true" ext="txt" screen="true" />
      <summary enable="true" ext="sum" whichtest="All Tests"
       persite="true" screen="true" />
      <edl enable="true" ext="edl" name="edlfile" perwafer="false" /> 
    </file>
  </datalog>
  <states>
    <state name="PROGRAM_LOAD">

    </state>
  </states>
</recipe>
